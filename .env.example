# App
APP_NAME="Marketing Automation"
DEBUG=true

# Security (required)
# Token for the internal API. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
# Dashboard login password (the dashboard also needs ADMIN_API_TOKEN)
DASHBOARD_PASSWORD=
# Extra browser origins allowed to call the API (the VSL page is same-origin and needs none)
CORS_ORIGINS=
# Token typed in the Meta (Facebook/WhatsApp) webhook settings
META_VERIFY_TOKEN=

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/marketing_db

# CRM - RD Station
RD_STATION_API_KEY=your-rd-station-key
RD_STATION_CLIENT_ID=your-client-id
RD_STATION_CLIENT_SECRET=your-client-secret

# Payments
STRIPE_SECRET_KEY=sk_test_your-stripe-key
MERCADOPAGO_ACCESS_TOKEN=your-mp-token

# Redis
REDIS_URL=redis://localhost:6379/0

# VSL sales funnel (/vsl)
VSL_VIDEO_URL=https://www.youtube.com/watch?v=SEU_VIDEO
VSL_CTA_DELAY_SECONDS=0
VSL_SIGNUP_URL=https://vitaclini.com.br/login?aba=cadastro
VSL_WHATSAPP_NUMBER=5511999999999
