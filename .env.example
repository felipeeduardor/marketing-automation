# App
APP_NAME="Marketing Automation"
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/marketing_db

# OpenAI
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# BotConversa
BOTCONVERSA_API_KEY=your-botconversa-key
BOTCONVERSA_WEBHOOK_SECRET=your-webhook-secret

# CRM - RD Station
RD_STATION_API_KEY=your-rd-station-key
RD_STATION_CLIENT_ID=your-client-id
RD_STATION_CLIENT_SECRET=your-client-secret

# Payments
STRIPE_SECRET_KEY=sk_test_your-stripe-key
MERCADOPAGO_ACCESS_TOKEN=your-mp-token

# Redis
REDIS_URL=redis://localhost:6379/0
